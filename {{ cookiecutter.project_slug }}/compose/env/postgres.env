POSTGRES_PASSWORD={{ cookiecutter.postgres_superuser_password }}
POSTGRES_USER={{ cookiecutter.postgres_superuser_user }}
POSTGRES_ODOO_PASSWORD={{ cookiecutter.odoo_db_password }}
POSTGRES_ODOO_USER={{ cookiecutter.odoo_db_user }}
POSTGRES_INITDB_ARGS=--locale=C --encoding=UTF8
{%- if cookiecutter.odoo_version|float < 19 %}
POSTGRES_ODOO_DB={{ cookiecutter.odoo_db_name }}
{%- endif %}
