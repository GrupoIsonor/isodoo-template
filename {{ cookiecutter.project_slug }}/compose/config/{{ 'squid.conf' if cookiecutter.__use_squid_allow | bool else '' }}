http_port 3128 intercept
http_port 3129

# --- ACLs ---
acl allowed_ports   port      "/etc/squid/allowed_ports.txt"
acl allowed_domains dstdomain "/etc/squid/allowed_domains.txt"
acl allowed_ips     dst       "/etc/squid/allowed_ips.txt"

# --- HTTP/S ---
http_access deny !allowed_ports
http_access allow allowed_ports allowed_domains
http_access allow allowed_ports allowed_ips

# --- Websockets ---
http_upgrade_request_protocols websocket allow allowed_ports allowed_domains
http_upgrade_request_protocols websocket allow allowed_ports allowed_ips
http_upgrade_request_protocols websocket deny all

# --- Block everything else ---
http_access deny all

# --- Miscellaneous ---
cache deny all
debug_options {{ cookiecutter._squid_debug_options }}
via off
forwarded_for off
host_verify_strict off
