{% set items = (cookiecutter.backup_restic_repos or "[]") | from_json -%}
{% if items | length > 1 -%}
  {% set config = {"version": "1"} -%}

  {% for item in items -%}
    {% set profile_name = "repo" ~ loop.index -%}
    {% set updated = item | combine({
      "password-file": "/run/secrets/backup_password",
      "backup": {
        "verbose": true,
        "source": ["/var/lib/odoo/data"],
        "exclude": ["/var/lib/odoo/data/sessions"]
      }
    }) -%}
    {% set _ = config.update({profile_name: updated}) -%}
  {% endfor -%}

{{ config | to_json(indent=2) }}
{% endif -%}
