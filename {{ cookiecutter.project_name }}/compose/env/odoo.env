{% from 'macros/networking.jinja' import get_hostname with context -%}
OCONF__options__db_host={{ get_hostname('db') }}
OCONF__options__db_user={{ cookiecutter.odoo_database_user }}
FOCONF__options__db_password=/run/secrets/odoo_database_password
OCONF__options__db_name={{ cookiecutter.odoo_database_name }}
OCONF__options__db_filter={{ cookiecutter.odoo_config_db_filter }}
OCONF__options__log_level=warn
OCONF__options__log_handler=:WARNING
OCONF__options__unnacent=True
