{% from 'macros/networking.jinja' import get_hostname with context -%}
http_proxy="http://{{ get_hostname('squid') }}:3129"
https_proxy="http://{{ get_hostname('squid') }}:3129"
ftp_proxy="http://{{ get_hostname('squid') }}:3129"
no_proxy="localhost,127.0.0.1,::1,*.local,10.0.0.0/8,192.168.0.0/16"
HTTP_PROXY="${http_proxy}"
HTTPS_PROXY="${https_proxy}"
NO_PROXY="${no_proxy}"
