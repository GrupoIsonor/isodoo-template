POSTGRES_PASSWORD_FILE=/run/secrets/superuser_database_password
POSTGRES_USER={{ cookiecutter.postgres_superuser_user }}
POSTGRES_ODOO_DB={{ cookiecutter.odoo_database_name }}
POSTGRES_ODOO_PASSWORD_FILE=/run/secrets/odoo_database_password
POSTGRES_ODOO_USER={{ cookiecutter.odoo_database_user }}
POSTGRES_INITDB_ARGS=--locale=C --encoding=UTF8
